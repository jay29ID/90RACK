# ── 90RACK configuration ─────────────────────────────────────────────
# Copy to .env and fill in what you have. Everything is optional: any
# component without a source just shows "NO DISC" and demo media.

# Where the rack listens. Keep 127.0.0.1 if you use Spotify (its OAuth
# only allows http:// redirects on loopback). Use 0.0.0.0 to reach the
# rack from another device on your LAN.
HOST=127.0.0.1
PORT=9090

# ── Plex ── DVD player (movies/TV) + CD changer (music)
# Find your token: https://support.plex.tv/articles/204059436
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

# ── Spotify ── Tuner. Needs Spotify Premium.
# Create an app at https://developer.spotify.com/dashboard, enable
# "Web API" + "Web Playback SDK", and add this Redirect URI:
#   http://127.0.0.1:9090/callback
SPOTIFY_CLIENT_ID=

# ── YouTube ── VCR. Optional: without a key you can still paste links.
# With a key (YouTube Data API v3) you also get search.
YOUTUBE_API_KEY=

# ── Emulators ── Game deck. Point at a folder of ROMs organised by
# system, e.g. roms/nes/*.nes, roms/snes/*.sfc, roms/genesis/*.md
ROMS_DIR=./roms
