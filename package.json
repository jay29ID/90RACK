{
  "name": "90rack",
  "version": "0.1.0",
  "private": true,
  "description": "A 90s hi-fi rack entertainment center for your modern library: Plex, Spotify, YouTube and emulators.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
