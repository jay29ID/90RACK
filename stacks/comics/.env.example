# Copy to .env (same folder as docker-compose.yml) and adjust.

# Where the apps keep their databases and settings.
CONFIG_ROOT=/srv/comics-stack/config

# Your media. Gets these subfolders:
#   comics/              Kapowarr's root folder, Komga's "Comics" library
#   books/               Shelfmark's downloads, Komga's "Books" library
#   downloads/kapowarr/  Kapowarr's temp folder while downloading
DATA_ROOT=/srv/media

# The user that should own the files (run `id` on the server to see yours).
PUID=1000
PGID=1000

TZ=America/New_York

# Host ports, change if something else already uses them.
KAPOWARR_PORT=5656
KOMGA_PORT=25600
SHELFMARK_PORT=8084

# Komga's Java heap. 2g is plenty for tens of thousands of issues.
KOMGA_MAX_MEMORY=2g
